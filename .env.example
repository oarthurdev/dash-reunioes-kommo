# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
PORT=3000
# Segredo para assinar o cookie de sessão (gere um valor longo e aleatório)
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio
SESSION_TTL_HOURS=12
# Opcional: exige ?secret=... na URL do webhook (recomendado em produção)
WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Login do dashboard (credenciais globais — valem para as duas contas)
# ---------------------------------------------------------------------------
DASH_USER=admin
DASH_PASS=troque-esta-senha

# Ou credenciais separadas por conta (têm prioridade sobre as globais):
# DICASA_DASH_USER=
# DICASA_DASH_PASS=
# MAZI_DASH_USER=
# MAZI_DASH_PASS=

# ---------------------------------------------------------------------------
# Conta DICASA (dicasa.seudominio.com)
# ---------------------------------------------------------------------------
DICASA_LABEL=Dicasa
# Subdomínio da conta na Kommo (dicasa.kommo.com)
DICASA_KOMMO_SUBDOMAIN=dicasa
# Token de longa duração da Kommo (opcional, mas recomendado: habilita nomes de
# status/corretor e detecção automática do status "Reunião" pelo nome)
DICASA_KOMMO_TOKEN=
# IDs de status que disparam o alerta (separados por vírgula). Se vazio e houver
# token, o servidor usa todo status cujo nome contenha "reuni".
DICASA_MEETING_STATUS_IDS=

# ---------------------------------------------------------------------------
# Conta MAZI (mazi.seudominio.com)
# ---------------------------------------------------------------------------
MAZI_LABEL=Mazi
MAZI_KOMMO_SUBDOMAIN=mazi
MAZI_KOMMO_TOKEN=
MAZI_MEETING_STATUS_IDS=
