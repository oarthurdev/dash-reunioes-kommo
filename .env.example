# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
PORT=3000
# Segredo para assinar o cookie de sessão (gere um valor longo e aleatório)
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio
SESSION_TTL_HOURS=12
# Opcional: exige ?secret=... na URL do webhook (recomendado em produção)
WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Login do dashboard
# Cada conta aceita ATÉ 3 usuários: <CONTA>_DASH_USER1/_PASS1 .. _USER3/_PASS3.
# Se a conta não tiver nenhum usuário definido, valem as credenciais globais.
# ---------------------------------------------------------------------------
DASH_USER=admin
DASH_PASS=troque-esta-senha

# Usuários da conta DICASA (até 3):
# DICASA_DASH_USER1=
# DICASA_DASH_PASS1=
# DICASA_DASH_USER2=
# DICASA_DASH_PASS2=
# DICASA_DASH_USER3=
# DICASA_DASH_PASS3=

# Usuários da conta MAZI (até 3):
# MAZI_DASH_USER1=
# MAZI_DASH_PASS1=
# MAZI_DASH_USER2=
# MAZI_DASH_PASS2=
# MAZI_DASH_USER3=
# MAZI_DASH_PASS3=

# ---------------------------------------------------------------------------
# Conta DICASA (dicasa.seudominio.com)
# ---------------------------------------------------------------------------
DICASA_LABEL=Dicasa
# Subdomínio da conta na Kommo (dicasa.kommo.com)
DICASA_KOMMO_SUBDOMAIN=dicasa
# Token de longa duração da Kommo (opcional, mas recomendado: habilita nomes de
# status/corretor e detecção automática do status "Reunião" pelo nome)
DICASA_KOMMO_TOKEN=
# IDs de status que disparam o alerta (separados por vírgula). Se vazio e houver
# token, o servidor usa todo status cujo nome contenha "reuni".
DICASA_MEETING_STATUS_IDS=
# IDs de status de reunião REALIZADA (barra verde do placar). Se vazio e houver
# token, detecta status cujo nome contenha "reuni" + "realizad".
DICASA_DONE_STATUS_IDS=

# ---------------------------------------------------------------------------
# Conta MAZI (mazi.seudominio.com)
# ---------------------------------------------------------------------------
MAZI_LABEL=Mazi
MAZI_KOMMO_SUBDOMAIN=mazi
MAZI_KOMMO_TOKEN=
MAZI_MEETING_STATUS_IDS=
MAZI_DONE_STATUS_IDS=

# ---------------------------------------------------------------------------
# Metas do placar (globais; aceitam versão por conta, ex.: DICASA_META_CORRETOR)
# ---------------------------------------------------------------------------
# Meta de reuniões por corretor no mês (escala das barras e coluna "Meta")
META_CORRETOR=25
# Meta de reuniões agendadas do time no mês (anel de progresso do topo)
META_TIME=20
